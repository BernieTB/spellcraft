/* Shared placeholder palette and sizes (ADR 0008): flat colours until the art pipeline is decided. */
:root {
    --color-background: rgb(38, 33, 30);
    --color-panel: rgb(58, 51, 46);
    --color-ink: rgb(240, 228, 210);
    --color-ink-muted: rgb(170, 158, 142);
    --color-accent: rgb(214, 150, 72);
    --color-success: rgb(132, 178, 108);
    --color-danger: rgb(214, 96, 82);
    --color-danger-background: rgb(88, 44, 40);
    --font-size-title: 72px;
    --font-size-heading: 44px;
    --font-size-body: 28px;
    --font-size-small: 22px;
}

.screen {
    flex-grow: 1;
    align-items: center;
    justify-content: center;
    background-color: var(--color-background);
}

.title {
    font-size: var(--font-size-title);
    -unity-font-style: bold;
    color: var(--color-ink);
}

.subtitle {
    margin-top: 16px;
    font-size: var(--font-size-body);
    color: var(--color-ink-muted);
}

.accent-bar {
    width: 240px;
    height: 8px;
    margin-top: 24px;
    background-color: var(--color-accent);
}

/* Hides an element without removing it from the tree (screens toggle it from C#). */
.hidden {
    display: none;
}

/* The wrapper a screen host puts around a cloned screen: it fills the host. */
.screen-slot {
    flex-grow: 1;
}
