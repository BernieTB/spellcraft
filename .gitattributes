# --- Test data compared byte for byte (golden fight traces) ---
game/Assets/_Project/Tests/**/Golden/*.txt text eol=lf

# --- Code ---
*.cs             text eol=lf diff=csharp
*.shader         text eol=lf
*.cginc          text eol=lf
*.hlsl           text eol=lf
*.compute        text eol=lf

