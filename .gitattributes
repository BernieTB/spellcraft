# Normalize line endings: text files are stored as LF in the repo
* text=auto

# --- Unity YAML (Force Text serialization) — Unity writes LF ---
*.unity          text eol=lf merge=unityyamlmerge diff
*.prefab         text eol=lf merge=unityyamlmerge diff
*.asset          text eol=lf merge=unityyamlmerge diff
*.meta           text eol=lf merge=unityyamlmerge diff
*.mat            text eol=lf merge=unityyamlmerge diff
*.anim           text eol=lf merge=unityyamlmerge diff
*.controller     text eol=lf merge=unityyamlmerge diff
*.overrideController text eol=lf merge=unityyamlmerge diff
*.physicMaterial text eol=lf merge=unityyamlmerge diff
*.physicsMaterial2D text eol=lf merge=unityyamlmerge diff
*.playable       text eol=lf merge=unityyamlmerge diff
*.mask           text eol=lf merge=unityyamlmerge diff
*.brush          text eol=lf merge=unityyamlmerge diff
*.flare          text eol=lf merge=unityyamlmerge diff
*.fontsettings   text eol=lf merge=unityyamlmerge diff
*.guiskin        text eol=lf merge=unityyamlmerge diff
*.giparams       text eol=lf merge=unityyamlmerge diff
*.renderTexture  text eol=lf merge=unityyamlmerge diff
*.spriteatlas    text eol=lf merge=unityyamlmerge diff
*.spriteatlasv2  text eol=lf merge=unityyamlmerge diff
*.terrainlayer   text eol=lf merge=unityyamlmerge diff
*.mixer          text eol=lf merge=unityyamlmerge diff
*.shadervariants text eol=lf merge=unityyamlmerge diff
*.preset         text eol=lf merge=unityyamlmerge diff
*.scenetemplate  text eol=lf merge=unityyamlmerge diff
*.lighting       text eol=lf merge=unityyamlmerge diff

# --- Other Unity text files ---
*.inputactions   text eol=lf
*.asmdef         text eol=lf
*.asmref         text eol=lf
*.uxml           text eol=lf
*.uss            text eol=lf
*.tss            text eol=lf
*.shadergraph    text eol=lf
*.shadersubgraph text eol=lf
ProjectVersion.txt text eol=lf
*.json           text eol=lf
.editorconfig    text eol=lf
.gitattributes   text eol=lf
.gitignore       text eol=lf
*.md             text eol=lf
