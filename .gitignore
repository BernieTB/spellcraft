# .gitignore for the Unity project located in /game.

# --- Unity-generated folders ---
/game/[Ll]ibrary/
/game/[Tt]emp/
/game/[Oo]bj/
/game/[Bb]uild/
/game/[Bb]uilds/
/game/[Ll]ogs/
/game/[Uu]ser[Ss]ettings/

# Memory captures and recordings (can get very large)
/game/[Mm]emoryCaptures/
/game/[Rr]ecordings/

# --- Generated IDE project files ---
.vs/
.gradle/
ExportedObj/
.consulo/
*.csproj
*.unityproj
*.sln
*.suo
*.tmp
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db

# Auto-generated Rider plugin
/game/[Aa]ssets/Plugins/Editor/JetBrains*

# Generated meta files
*.pidb.meta
*.pdb.meta
*.mdb.meta

# Crash reports
sysinfo.txt
crashlytics-build.properties

# --- Builds and packages ---
*.apk
*.aab
*.unitypackage
*.unitypackage.meta
*.app

# Packed Addressables
/game/[Aa]ssets/[Aa]ddressable[Aa]ssets[Dd]ata/*/*.bin*

# Temporary auto-generated Android assets
/game/[Aa]ssets/[Ss]treamingAssets/aa.meta
/game/[Aa]ssets/[Ss]treamingAssets/aa/*

# --- Unity license and secrets (NEVER commit these) ---
*.ulf
*.alf
.env
.env.*
*.pem
*.key

# --- Editors ---
.idea/
.vscode/
*.swp

# --- Operating system files ---
.DS_Store
Thumbs.db
desktop.ini

# --- Claude Code (local state only) ---
# Shared project config (.claude/settings.json, commands/, agents/, skills/) stays versionable.
/.claude/worktrees/
/.claude/settings.local.json
CLAUDE.local.md

# --- Local test results and reports ---
# Default output folder of the headless simulation runner (SimulationRunner).
/game/[Ss]imulation[Rr]esults/
results.xml
TestResults/
coverage/
