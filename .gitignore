# .gitignore for a Unity project located at the repository root.
# If the project lives in a subfolder (e.g. /game), place this file
# in that subfolder instead.

# --- Unity-generated folders ---
/[Ll]ibrary/
/[Tt]emp/
/[Oo]bj/
/[Bb]uild/
/[Bb]uilds/
/[Ll]ogs/
/[Uu]ser[Ss]ettings/

# Memory captures and recordings (can get very large)
/[Mm]emoryCaptures/
/[Rr]ecordings/

# --- Generated IDE project files ---
.vs/
.gradle/
ExportedObj/
.consulo/
*.csproj
*.unityproj
*.sln
*.suo
*.tmp
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db

# Auto-generated Rider plugin
/[Aa]ssets/Plugins/Editor/JetBrains*

# Generated meta files
*.pidb.meta
*.pdb.meta
*.mdb.meta

# Crash reports
sysinfo.txt
crashlytics-build.properties

# --- Builds and packages ---
*.apk
*.aab
*.unitypackage
*.unitypackage.meta
*.app

# Packed Addressables
/[Aa]ssets/[Aa]ddressable[Aa]ssets[Dd]ata/*/*.bin*

# Temporary auto-generated Android assets
/[Aa]ssets/[Ss]treamingAssets/aa.meta
/[Aa]ssets/[Ss]treamingAssets/aa/*

# --- Unity license and secrets (NEVER commit these) ---
*.ulf
*.alf
.env
.env.*
*.pem
*.key

# --- Editors ---
.idea/
.vscode/
*.swp

# --- Operating system files ---
.DS_Store
Thumbs.db
desktop.ini

# --- Claude Code (local settings only) ---
.claude/settings.local.json

# --- Local test results and reports ---
results.xml
TestResults/
coverage/
